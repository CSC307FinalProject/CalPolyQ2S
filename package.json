{
  "name": "final_proj",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "lint": "npm run lint --workspace frontend && npx prettier --check .",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "nodemon express-backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build --workspace frontend",
    "start": "node express-backend",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "workspaces": [
    "packages/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supabase": "^2.98.2",
    "vite": "^8.0.9"
  },
  "dependencies": {
    "react-router-dom": "^7.14.2",
    "@supabase/supabase-js": "^2.105.3",
    "object-assign": "^4.1.1"
  }
}
